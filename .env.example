# Lokaal draaien? Kopieer naar .env en vul in. Op Railway zet je deze als variabelen.
# Railway MySQL: koppel bij de app-service -> Variables:
#   MYSQL_URL = ${{ MySQL.MYSQL_URL }}
MYSQL_URL=mysql://user:password@host:3306/railway

# Geheime sleutel voor inlog-tokens. Verzin een lange willekeurige tekst.
JWT_SECRET=verander-dit-in-iets-lang-en-willekeurigs

# Poort (Railway vult dit zelf in)
PORT=3000
